<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="CodeAnalysis.props" Sdk="TedToolkit.Build.Sdk" />
  <Import Project="NugetPackage.props" Sdk="TedToolkit.Build.Sdk" />
  <Import Project="AlmostAllFrameworks.props" Sdk="TedToolkit.Build.Sdk" />

  <PropertyGroup>
    <TargetFrameworks>$(TargetFrameworks);net11.0</TargetFrameworks>
    <Title>TedToolkit.Results.SystemTextJson</Title>
    <Description>System.Text.Json converters for TedToolkit Results.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Text.Json"
                      Condition="'$(TargetFramework)' != 'net6.0' and '$(TargetFramework)' != 'net7.0'" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TedToolkit.Results\TedToolkit.Results.csproj" />
  </ItemGroup>

</Project>
